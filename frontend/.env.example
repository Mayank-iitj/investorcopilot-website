# Required in production (Vercel)
# Public backend base URL used by Next.js rewrites and browser requests.
# Example: https://investorcopilot-backend.onrender.com
NEXT_PUBLIC_BACKEND_URL=

# Optional: direct WebSocket endpoint for live alerts.
# If omitted, frontend uses same-origin /ws/alerts.
# Example: wss://investorcopilot-backend.onrender.com/ws/alerts
NEXT_PUBLIC_WS_ALERTS_URL=
